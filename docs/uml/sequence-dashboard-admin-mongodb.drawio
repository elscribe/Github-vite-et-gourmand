        <mxCell id="msg_14" parent="1" value="Affiche cartes, tableau, graphique et source des statistiques" style="endArrow=block;html=1;rounded=0;dashed=1;strokeColor=#64748b;fontSize=11;" edge="1">
          <mxGeometry as="geometry" relative="1">
