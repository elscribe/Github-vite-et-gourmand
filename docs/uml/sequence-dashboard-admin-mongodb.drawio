        <mxCell id="note_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;fontColor=#422006;" value="&lt;b&gt;Règle d'architecture&lt;/b&gt;&lt;br&gt;Le dashboard et le graphique lisent toujours &lt;b&gt;MongoDB menu_statistics&lt;/b&gt;.&lt;br&gt;MariaDB reste la source métier, mais elle n'alimente le graphique qu'indirectement via la synchronisation SQL → NoSQL." vertex="1">
          <mxGeometry height="175" width="470" x="2020" y="720" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="note_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;fontColor=#422006;" value="&lt;b&gt;À défendre à l'oral&lt;/b&gt;&lt;br&gt;Même si les statistiques sont absentes ou obsolètes, on recalcule les agrégats puis on relit MongoDB. Le contrôleur ne contourne pas la base non relationnelle." vertex="1">
          <mxGeometry height="170" width="470" x="2020" y="1500" as="geometry"></mxGeometry>
