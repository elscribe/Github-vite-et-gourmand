            <mxPoint x="165.0" y="1320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note_1" parent="1" value="&lt;b&gt;Règle d'architecture actuelle&lt;/b&gt;&lt;br&gt;MongoDB est lu en premier via &lt;b&gt;StatisticsModel&lt;/b&gt; et &lt;b&gt;mongosh&lt;/b&gt;.&lt;br&gt;Le code lit surtout &lt;b&gt;menu_monthly_statistics&lt;/b&gt; pour filtrer par menu et période, et compte les menus actifs dans &lt;b&gt;menu_statistics&lt;/b&gt;.&lt;br&gt;SQL reste la source métier et sert de secours local." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;fontColor=#422006;" vertex="1">
          <mxGeometry as="geometry" x="1930" y="470" width="420" height="220" />
        </mxCell>
        <mxCell id="note_2" parent="1" value="&lt;b&gt;Pourquoi pas AggregationService ici ?&lt;/b&gt;&lt;br&gt;Un service dédié serait utile pour recalculer et écrire les agrégats MongoDB après chaque commande.&lt;br&gt;Dans le MVP codé, cette écriture automatique n’existe pas encore : le diagramme montre donc la lecture réelle et le secours SQL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;fontColor=#422006;" vertex="1">
          <mxGeometry as="geometry" x="1930" y="820" width="420" height="180" />
        </mxCell>
      </root>
    </mxGraphModel>
