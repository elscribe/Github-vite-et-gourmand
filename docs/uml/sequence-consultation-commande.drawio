        </mxCell>
        <mxCell id="note_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;fontColor=#422006;" value="&lt;b&gt;Traçabilité&lt;/b&gt;&lt;br&gt;La commande démarre en en_attente pour permettre modification/annulation client avant acceptation employé.&lt;br&gt;Le stock du menu est décrémenté après validation de la commande." vertex="1">
