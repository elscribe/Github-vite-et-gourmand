        <mxCell id="note_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=8;fontColor=#422006;" value="&lt;div&gt;&lt;b&gt;Règles prix&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Bordeaux : prix_livraison = 0 EUR et distance_km = 0.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Hors Bordeaux : prix_livraison = 5 EUR + 0,59 EUR/km.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;distance_km est conservée pour justifier le calcul.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Remise de 10 % si nombre_personnes &amp;gt;= nombre minimum + 5.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Le stock du menu est décrémenté après validation de la commande.&lt;/b&gt;&lt;/div&gt;" vertex="1">
