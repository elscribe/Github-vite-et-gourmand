        <mxCell id="p_avis" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#92400e;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#111827;" value="&lt;div&gt;&lt;b&gt;avis&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;id_avis INT UNSIGNED PK AI&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;id_utilisateur INT UNSIGNED FK NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;id_commande INT UNSIGNED FK UNIQUE NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;note TINYINT UNSIGNED NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;commentaire TEXT NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;statut VARCHAR(30) NOT NULL DEFAULT 'en_attente'&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;created_at DATETIME DEFAULT CURRENT_TIMESTAMP&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;moderated_at DATETIME NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;moderated_by INT UNSIGNED NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK id_utilisateur REFERENCES utilisateurs(id_utilisateur) ON DELETE RESTRICT&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK id_commande REFERENCES commandes(id_commande) ON DELETE CASCADE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK moderated_by REFERENCES utilisateurs(id_utilisateur) ON DELETE SET NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CHECK (note BETWEEN 1 AND 5)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CHECK (statut IN ('en_attente', 'valide', 'refuse'))&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="510" x="50" y="1060" as="geometry"></mxGeometry>
