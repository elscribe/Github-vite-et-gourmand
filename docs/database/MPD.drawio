        <mxCell id="p_menus" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#92400e;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#111827;" value="&lt;div&gt;&lt;b&gt;menus&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;id_menu INT UNSIGNED PK AI&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;id_regime INT UNSIGNED FK NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;id_theme INT UNSIGNED FK NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;titre VARCHAR(120) NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;description TEXT NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;conditions TEXT NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;nombre_personnes_minimum INT UNSIGNED NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;prix_minimum DECIMAL(10,2) NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;stock_disponible INT UNSIGNED DEFAULT 0&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;actif BOOLEAN DEFAULT TRUE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;created_at DATETIME DEFAULT CURRENT_TIMESTAMP&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;updated_at DATETIME NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK id_regime REFERENCES regimes(id_regime) ON DELETE RESTRICT&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK id_theme REFERENCES themes(id_theme) ON DELETE RESTRICT&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CHECK (nombre_personnes_minimum &amp;gt; 0)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CHECK (prix_minimum &amp;gt;= 0)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CHECK (stock_disponible &amp;gt;= 0)&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="470" x="570" y="120" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="p_images" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#92400e;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#111827;" value="&lt;b&gt;menu_images&lt;/b&gt;&lt;br&gt;id_image INT UNSIGNED PK AI&lt;br&gt;id_menu INT UNSIGNED FK NOT NULL&lt;br&gt;url VARCHAR(255) NOT NULL&lt;br&gt;texte_alternatif VARCHAR(180) NOT NULL&lt;br&gt;position INT UNSIGNED DEFAULT 1&lt;br&gt;id_menu → menus : ON DELETE CASCADE" vertex="1">
