        <mxCell id="p_contacts" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#92400e;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#111827;" value="&lt;div&gt;&lt;b&gt;contact_messages&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;id_contact_message INT UNSIGNED PK AI&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;titre VARCHAR(160) NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;email VARCHAR(120) NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;description TEXT NOT NULL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;created_at DATETIME DEFAULT CURRENT_TIMESTAMP&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;traite BOOLEAN DEFAULT FALSE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CHECK (email LIKE '%@%')&lt;/b&gt;&lt;/div&gt;" vertex="1">
