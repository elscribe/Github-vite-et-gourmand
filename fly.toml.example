# Copy this file to fly.toml when the Fly.io application is created.
# The app name must be replaced by the real Fly.io app name before deploy.

app = "vite-et-gourmand-ecf"
primary_region = "cdg"

[build]
  dockerfile = "Dockerfile"

[env]
  APP_NAME = "ViteEtGourmand"
  APP_ENV = "production"
  APP_DEBUG = "false"
  APP_DISPLAY_ERRORS = "false"
  APP_LOG_ERRORS = "true"
  APP_LOG_PATH = "storage/logs/app.log"
  APP_TIMEZONE = "Europe/Paris"
  SESSION_SECURE = "true"
  SESSION_HTTP_ONLY = "true"
  SESSION_SAME_SITE = "Lax"
  DB_CONNECTION = "mysql"
  DB_PORT = "3306"
  NOSQL_CONNECTION = "mongodb"
  NOSQL_PORT = "27017"
  NOSQL_DATABASE = "vite_gourmand"
  MAIL_MAILER = "log"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0
  processes = ["app"]

[[vm]]
  memory = "512mb"
  cpu_kind = "shared"
  cpus = 1
