{
  "name": "elscribe/vite-et-gourmand",
  "description": "Application MVC en PHP pour le projet ECF Vite & Gourmand.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "validate:composer": "composer validate --strict",
    "lint": "find app config public -name '*.php' -print0 | xargs -0 -n1 php -l",
    "check": [
      "@validate:composer",
      "@lint"
    ],
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "extra": {
    "purpose": "Composer manages project metadata, PHP requirements, and PSR-4 autoloading for application classes."
  }
}
