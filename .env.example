### APPLICATION ###
APP_NAME=ViteEtGourmand
APP_ENV=local
APP_DEBUG=true
APP_DISPLAY_ERRORS=true
APP_LOG_ERRORS=true
APP_LOG_PATH=storage/logs/app.log
APP_TIMEZONE=Europe/Paris
APP_URL=http://localhost:8000

### SECURITY ###
# << IMPORTANT >> Replace this value in your local .env file.
APP_KEY=change_me
PASSWORD_MIN_LENGTH=10
SESSION_NAME=vite_gourmand_session
SESSION_LIFETIME_MINUTES=120
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

### DATABASE SQL ###
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vite_gourmand
DB_USER=root
DB_PASSWORD=password

### DATABASE NOSQL ###
NOSQL_CONNECTION=mongodb
NOSQL_HOST=localhost
NOSQL_PORT=27017
NOSQL_DATABASE=vite_gourmand

### EMAIL ###
# [[ TEMPORARY ]] Use "log" locally until a real SMTP provider is selected.
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="Vite et Gourmand"
MAIL_CONTACT_TO=contact@vitegourmand.test

### DELIVERY ###
STORE_CITY=Bordeaux
DELIVERY_BASE_FEE=5.00
DELIVERY_PRICE_PER_KM=0.59
DELIVERY_DISTANCE_PROVIDER=manual
